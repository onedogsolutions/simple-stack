# Compiled admin bundle is generated by `npm run build` but committed so the
# plugin is deployable without a Node toolchain.
assets/dist/** linguist-generated=true
assets/dist/**/*.js linguist-detectable=false
assets/dist/**/*.css linguist-detectable=false

# Provisioning scripts ship as .txt but are Bash.
includes/core/apps/*/scripts/*/raw/*.txt linguist-language=Shell
